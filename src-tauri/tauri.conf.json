{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BOOM",
  "version": "0.1.0",
  "identifier": "com.wangc.academic-administration-system",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BOOM",
        "width": 1480,
        "height": 980,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "RWQl58EUEMbdPUmESAu03PTZPsL6MldwWSoV/rTS4pFTNJtOwov4xXgq",
      "endpoints": [
        "https://github.com/Thunder-077/Boom/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": {
      "vendor/or-tools_x64_VisualStudio2022_cpp_v9.12.4544/bin/": "ortools/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
